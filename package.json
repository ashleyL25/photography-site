{
  "name": "ashley-photography",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "PORT=3000 tsx watch --env-file=.env server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build",
    "//build:api": "`--noCheck` emits without type-checking. Hostinger's build container has killed a full `tsc` outright on the sister sites — checking belongs on a developer machine, and `npm run typecheck` still does it.",
    "build:api": "tsc -p tsconfig.server.json --noCheck",
    "start": "node dist/server/index.js",
    "start:local": "node --env-file=.env dist/server/index.js",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "hash-password": "node scripts/hash-password.mjs",
    "env:push": "node scripts/push-env.mjs",
    "images": "node scripts/optimize-images.mjs"
  },
  "//dependencies": "Hostinger runs `npm install && npm run build` ON THE SERVER, and npm omits devDependencies when NODE_ENV=production. The build toolchain therefore has to be a real dependency or the deploy produces no dist/ and Passenger serves a bare 503 — the same lesson as pic and elise-portfolio.",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@aws-sdk/s3-request-presigner": "^3.1105.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-react": "^6.0.4",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "lenis": "^1.3.25",
    "motion": "^12.43.0",
    "mysql2": "^3.23.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.11"
  },
  "optionalDependencies": {
    "puppeteer-core": "^25.4.0",
    "sharp": "^0.35.3"
  }
}
