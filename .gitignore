# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Untouched originals (~900 MB). Optimized WebPs in public/photos ship instead.
# Note: the originals already committed before this rule was added stay tracked —
# `git ls-files images/` lists them — so a deleted original is recoverable.
images/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local env overrides (VITE_* manifest URLs, etc.)
.env
.env.local
.env.*.local

# Location renditions bound for the Cloudflare bucket, not for git.
.locations-build
