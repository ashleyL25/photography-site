# Copy to .env and fill in. Never commit .env.
#
# On Hostinger these can live either in hPanel -> Node.js -> Environment
# variables, or in a .env file placed next to the app. Real environment
# variables win when both exist. Leave NODE_ENV unset — see the README.

# openssl rand -base64 32
SESSION_SECRET=

# Hostinger MySQL (MariaDB). DB_HOST is `localhost` on the server; from a
# developer machine it is the remote host, with your IP under Remote MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=u628890763_ashleyl25
DB_PASSWORD=
DB_NAME=u628890763_portfolio

# Cloudflare R2 — the img-ashleyphotography bucket. Optional: without these the
# site runs in full and only uploading new photographs is switched off.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=img-ashleyphotography
# The bucket's public read URL. Every uploaded photograph's address is built
# from it and stored, so pick the permanent one before going live.
R2_PUBLIC_URL=

# Absolute origin, for links that leave the app.
PUBLIC_BASE_URL=https://ashleyphotographyia.com

# Inquiry emails (Resend). Without them inquiries are still stored and shown in
# the dashboard under Inquiries.
RESEND_API_KEY=
MAIL_FROM=Ashley Photography <no-reply@send.ashleyphotographyia.com>
MAIL_TO=ashleydesignia@gmail.com

# The owner account `npm run db:seed` creates. Change the password after first sign-in.
OWNER_EMAIL=almcdowell.home@gmail.com
OWNER_PASSWORD=

# Hostinger API, for `npm run env:push`.
HOSTINGER_API_TOKEN=
HOSTINGER_ACCOUNT=
HOSTINGER_DOMAIN=ashleyphotographyia.com
